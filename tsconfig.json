{
  "compilerOptions": {
    "types": ["node"],
    
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "strict": false,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": [
      "ESNext",
      "ES2022"
    ]
  },
  "exclude": [
    "**/libs/**",
    "**/docs/**",
    "build/**",
    "node_modules/",
    "index.mjs"
  ],
  "ts-node": {
    "files": true,
    "esm": true,
    "transpileOnly": true
  }
}
